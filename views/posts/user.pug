extends ../layout

block main
  p.welcome #{username}'s messages.

  section.messages
    table.posts
      each post in posts
        tr.post
          td= post.message
          td= dateFormat(post.createdAt)

  //- ページネーション
  .pagination
    a(href=`/posts/user/${userId}/${page - 1}`).previous-button << prev
    a(href=`/posts/user/${userId}/${page + 1}`).next-button next >>