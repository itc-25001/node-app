extends ../layout

block main
  p.welcome Welcome to #{username}.

  section.add
    form(method='post' action='/posts/add')
      input(type='text' name='msg' placeholder='メッセージ')
      button(type='submit') ポスト

  section.messages
    table.posts
      each post in posts
        tr.post
          th
            a(href=`/posts/user/${post.author.id}`)= post.author.name
          td= post.message
          td= dateFormat(post.createdAt)

  //- ページネーション
  .pagination
    a(href=`/posts/${page - 1}`).previous-button << prev
    a(href=`/posts/${page + 1}`).next-button next >>